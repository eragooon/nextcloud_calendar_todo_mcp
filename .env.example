# Nextcloud CalDAV connection
NEXTCLOUD_URL=https://your-nextcloud-instance.example.com/
NEXTCLOUD_USER=youruser
NEXTCLOUD_APP_PASSWORD=your-app-password-here

# Calendar / task list display names (as shown in Nextcloud)
CALENDAR_NAME=Personal
FAMILY_CALENDAR_NAME=Family
TASKS_CALENDAR_NAME=Tasks

# OAuth 2.0 client credentials (choose any ID and a strong random secret)
OAUTH_CLIENT_ID=calendar-todo-client
OAUTH_CLIENT_SECRET=replace-with-a-strong-random-secret

# OAuth redirect URI (Claude Web default)
OAUTH_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback

# Server binding
HOST=127.0.0.1
PORT=8000

# Public URL exposed via Tailscale Funnel (must match your Tailscale hostname)
RESOURCE_SERVER_URL=https://your-machine.your-tailnet.ts.net/
